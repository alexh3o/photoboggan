<?xml version="1.0" encoding="utf-8"?>
<!-- Custom installer texts (English, default). Overrides the Tauri and WixUI defaults by string Id. -->
<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="LaunchApp">Launch photoboggan</String>
  <String Id="DowngradeErrorMessage">A newer version of photoboggan is already installed.</String>
  <String Id="InstallAppFeature">Installs photoboggan.</String>
  <String Id="PathEnvVarFeature">Adds the photoboggan folder to the system PATH environment variable.</String>

  <String Id="WelcomeDlgTitle">{\WixUI_Font_Title}Welcome to the [ProductName] Setup</String>
  <String Id="WelcomeDlgDescription">This wizard installs [ProductName] on your computer: a fast, lightweight, fully local photo library viewer. Your photos stay where they are; nothing is copied or uploaded.

Click Next to continue.</String>
  <String Id="LicenseAgreementDlgTitle">{\WixUI_Font_Title}License Agreement</String>
  <String Id="LicenseAgreementDlgDescription">Please read the license below before continuing.</String>
  <String Id="LicenseAgreementDlgLicenseAcceptedCheckBox">I accept the terms of the license</String>
  <String Id="InstallDirDlgTitle">{\WixUI_Font_Title}Destination Folder</String>
  <String Id="InstallDirDlgDescription">Choose where to install [ProductName].</String>
  <String Id="InstallDirDlgFolderLabel">Install [ProductName] to:</String>
  <String Id="InstallDirDlgChange">&amp;Browse…</String>
  <String Id="VerifyReadyDlgTitle">{\WixUI_Font_Title}Ready to Install</String>
  <String Id="VerifyReadyDlgInstallText">Click Install to begin installing [ProductName].</String>
  <String Id="VerifyReadyDlgInstallTitle">{\WixUI_Font_Title}Ready to Install</String>
  <String Id="ProgressDlgTitleInstalling">{\WixUI_Font_Title}Installing [ProductName]</String>
  <String Id="ProgressDlgTextInstalling">Please wait while [ProductName] is being installed.</String>
  <String Id="ExitDialogTitle">{\WixUI_Font_Bigger}[ProductName] is installed</String>
  <String Id="ExitDialogDescription">Click Finish to close the wizard.</String>
</WixLocalization>
