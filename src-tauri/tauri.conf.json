{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "photoboggan",
  "version": "0.3.9",
  "identifier": "com.alexh3o.photoboggan",
  "build": {
      "beforeDevCommand": "npm run fetch-exiftool -- --optional && npm run dev",
      "beforeBuildCommand": "npm run fetch-exiftool && npm run build",
      "devUrl": "http://localhost:5173",
      "frontendDist": "../dist"
    },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "photoboggan",
        "width": 1024,
        "height": 768,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/exiftool/": "exiftool/"
    },
    "linux": {
      "deb": { "depends": ["perl"] },
      "rpm": { "depends": ["perl"] }
    }
  }
}
