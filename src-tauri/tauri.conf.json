{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "photoboggan",
  "version": "0.6.6",
  "identifier": "com.alexh3o.photoboggan",
  "build": {
      "beforeDevCommand": "npm run fetch-exiftool -- --optional && npm run dev",
      "beforeBuildCommand": "npm run fetch-exiftool && npm run build",
      "devUrl": "http://localhost:5173",
      "frontendDist": "../dist"
    },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "photoboggan",
        "width": 1024,
        "height": 768,
        "minWidth": 900,
        "minHeight": 500,
        "visible": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost data: https://tiles.openfreemap.org",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost data: https://tiles.openfreemap.org ws://localhost:5173 http://localhost:5173",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "deb"],
    "licenseFile": "LICENSE.rtf",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/exiftool/": "exiftool/",
      "resources/map-style/": "map-style/"
    },
    "linux": {
      "deb": { "depends": ["perl"] },
      "rpm": { "depends": ["perl"] }
    },
    "windows": {
      "wix": {
        "bannerPath": "icons/msibanner.bmp",
        "dialogImagePath": "icons/msidialog.bmp",
        "language": {
          "en-US": { "localePath": "wix/en-US.wxl" },
          "fr-FR": { "localePath": "wix/fr-FR.wxl" }
        }
      }
    }
  }
}
