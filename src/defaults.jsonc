// Default settings of a NEW installation (a value already saved by the user always wins).
// Single source of truth: read by the frontend (src/settings-defaults.js) and, for the "faceSettings" section,
// by the Rust backend (src-tauri/src/face_detect.rs, via include_str!).
// Keys are the localStorage keys. Only FULL-LINE comments (lines starting with //) are allowed: both readers
// drop those lines before parsing, so never put a comment after a value.
// Booleans: true | false.
{
  // ---------------------------------------------------------------- Panels and toolbar
  // Left panel (folders).
  "sidebarVisible": true,
  // Preview panel.
  "previewVisible": true,
  // Right panel (Info / Keywords).
  "exifVisible": false,
  // Toolbar hidden until the mouse reaches the top of the window.
  "toolbarAutoHide": false,
  // Text labels under the toolbar icons.
  "toolbarShowLabels": true,
  // Info overlay in full screen.
  "fullscreenInfoVisible": false,

  // ---------------------------------------------------------------- Display options
  // "square" | "framed" | "justified" | "masonry".
  "thumbnailLayout": "justified",
  // "auto" (none for the justified layout, normal otherwise) | "none" | "small" | "normal".
  "thumbnailSpacing": "none",
  // Thumbnail corner rounding: "no" | "light" | "medium" | "strong" | "max".
  "thumbnailCorners": "no",
  // Thumbnail display size in px: 96 to 1024, multiple of 16 (also capped by thumbnailCacheSize).
  "thumbnailSize": 512,
  // Badge on geolocated photos.
  "showGeoBadges": true,
  // Badge on RAW photos.
  "showRawBadges": true,
  // Include the subfolders of the selected folder.
  "includeSubfolders": false,
  // Folders without any photo shown in the tree.
  "showEmptyFolders": true,
  // Photo count next to each folder.
  "showFolderCounts": true,
  // Marking bars (rating, color, pick): "off" | "panel" | "floating" | "hybrid".
  "markingPlacement": "hybrid",
  // Dim unselected photos on hover: "none" | "0.75" (light) | "0.65" (medium) | "0.5" (strong). A string.
  "dimUnselectedOnHover": "0.65",
  // Small map widget in the Info panel.
  "showInfoMapWidget": false,
  // Histogram of the current photo.
  "showHistogram": false,
  // Clipped shadows / highlights painted on the image.
  "showClippings": false,
  // Clipping colors: "colors" (red / blue) | "bw" (black / white, pulsing).
  "clippingMode": "bw",
  // Clipping range: integer 0 to 20.
  "clippingRange": 3,
  // Histogram curves: false = luminance, true = three RGB curves.
  "histogramRgb": false,
  // "system" (follows the light / dark setting of the OS) | "dark" | "light".
  "appTheme": "system",
  // Text size in percent: integer 80 to 140, in steps of 5.
  "textSize": 100,
  // Interface font: an id from APP_FONTS in src/app-fonts.js ("system" | "inter" | "manrope" | "geist" | "raleway").
  "appFont": "raleway",
  // Selection color: "#rrggbb".
  "selectionColor": "#15932a",
  // Active buttons color: "#rrggbb".
  "activeButtonColor": "#1e72ad",

  // ---------------------------------------------------------------- Sort
  // "taken" (date taken) | "modified" (date modified) | "name" (file name).
  "photoSortKey": "taken",
  // "desc" | "asc".
  "photoSortOrder": "desc",
  // Separators when sorted by date: "none" | "day" | "week" | "month" | "year".
  "photoDateSeparator": "none",
  // Separators when sorted by name: "none" | "folder".
  "photoNameSeparator": "none",

  // ---------------------------------------------------------------- Settings: General and Storage
  // Language code: "fr" | "en" | "es" (must exist in src/locales/ and in LANGUAGES, src/i18n.js).
  "appLanguage": "en",
  // At startup: "all" (all photos) | "last" (last opened location).
  "startupView": "all",
  // Display order of the root folders in the tree: list of folder paths, reordered in Settings > General. Empty = order of the database (by path).
  "folderOrder": [],
  // Folders unfolded in the tree (normalized paths: "/", lower case, no trailing "/"), saved after each change. null = nothing saved yet: the root folders start unfolded.
  "folderTreeExpanded": null,
  // Ask before replacing the filters of a smart album.
  "albumOverwriteWarning": true,
  // Offline mode: never connects to the Internet.
  "offlineMode": false,
  // Private photos (privacy.js): the feature is on, and the privacy lock keeps the sets from being changed outside Settings.
  // The sets themselves (privacySets) and the ids of the active ones (privacyActive) are JSON saved by privacy.js.
  "privacyEnabled": false,
  "privacyLock": false,
  // Check GitHub for updates (ignored in offline mode).
  "checkUpdates": false,
  // Also propose beta versions.
  "includePrereleases": false,
  // Verify (SHA-256) moves between drives.
  "verifyCrossDriveMoves": true,
  // Thumbnail cache resolution in px: 512 | 768 | 1024.
  "thumbnailCacheSize": 1024,
  // Thumbnail JPEG quality: "normal" (q60, about half the size) | "high" (q84). Mirrored in config.json by the backend.
  "thumbnailQuality": "normal",
  // Full screen: show the cached thumbnail while the full-resolution photo decodes, then swap in the sharp image (Settings > Storage > Thumbnail cache).
  "fullscreenThumbnailPreload": false,

  // ---------------------------------------------------------------- Settings: Metadata, Maps
  // Color labels enabled.
  "colorLabelEnabled": true,
  // Pick / reject flags enabled.
  "pickLabelEnabled": false,
  // Include/exclude children with their parents by default when adding a keyword filter.
  "keywordFilterIncludeChildren": true,
  // Apply keyword, title and description changes automatically.
  "keywordsAutoApply": false,
  // Show a map of the photo location (needs Internet unless the area is saved on disk).
  "showMap": false,
  // Default map zoom for one photo: integer 7 to 14.
  "mapDefaultZoom": 12,
  // Download the map style with each zone download.
  "mapStyleRefresh": true,

  // ---------------------------------------------------------------- Settings: Faces (frontend part)
  // Read face regions written by other programs.
  "faceReading": true,
  // Face detection and recognition.
  "faceDetection": false,
  // Always include the subfolders when detecting faces.
  "faceScanSubfolders": false,
  // Face regions in full screen and preview: "hidden" | "hover" | "always".
  "fullscreenFacesVisible": "hover",
  // Keyword root for new people (e.g. "#CONTACTS"); empty = first level of the keyword tree.
  "facePersonRoot": "",
  // Order of the faces inside a group of the Faces view: "grid" (as the photos of the main grid) | "score" (most similar first).
  "facesViewSort": "grid",

  // ---------------------------------------------------------------- Settings: Content search
  // Content search (local AI, SigLIP 2): off until the user enables it and installs the model.
  "semanticSearch": false,
  // Analyse the RAW files too (through their embedded preview); false leaves them out of every analysis and of the counts.
  "semanticScanRaw": true,
  // Write the missing thumbnails to the cache while the analysis decodes their photo (JPEG, RAW, HEIC): true | false.
  "semanticWriteThumbnails": false,
  // ONNX Runtime threads of the content analysis: 1 (low) | 2 (normal) | 4 (high).
  "semanticScanThreads": 1,
  // Relative relevance threshold of the results (0.005 to 0.08): kept when cosine >= best - this value.
  "semanticRelevance": 0.03,
  // Also return photos matching a keyword by content when filtering by keyword (shown after the tagged ones).
  "semanticInKeywordSearch": false,
  // Content search from the toolbar box also lists the photos tagged with the typed keyword(s) first.
  "semanticKeywordsInSearch": true,
  // Show the match score on the results of a content search.
  "semanticShowScore": false,
  // Scope of a content search: "view" (current view) | "library".
  "semanticScope": "view",
  // Order of the photos tagged with the keyword typed in the toolbar search box: "grid" (the sort options) | "score" (content score, best first).
  "semanticKeywordSort": "grid",
  // Keywords never suggested by the content search, nor any keyword below them: ids of keyword_nodes, e.g. [12, 40] (set in Settings > Content search).
  "semanticExcludedKeywords": [],
  // "Suggestions" block of the Keywords tab (keywords suggested for the selected photo): unfolded (true) | folded (false).
  "keywordSuggestionsOpen": true,
  // "Author" section of the Info tab (author, copyright notice, credit, usage terms, author e-mail): unfolded (true) | folded (false).
  "infoAuthorOpen": false,
  // Scans left unfinished (paused, or interrupted by quitting): they come back paused at the next launch. List of tasks, empty on a new installation.
  "pausedScanTasks": [],

  // ---------------------------------------------------------------- Settings: Duplicates
  // Worker threads for duplicate hashing: "auto" | "1" | "2" | "4".
  "duplicateHashThreads": "auto",
  // Compute similarity hashes during content analysis.
  "duplicateHashOnSemantic": true,
  // Compute hashes during integrity checks (similarity + exact; pre-pass only for RAW).
  "duplicateHashOnIntegrity": true,
  // Automatically compute hashes for new photos in the background after scan/sync.
  "duplicateAutoHash": false,
  // What auto-hash computes: "similarity" | "exact_prepass" | "exact_full" | "both_prepass" | "both_full".
  "duplicateAutoHashMode": "both_prepass",
  // Include RAW files in background auto-hashing.
  "duplicateAutoHashRaw": false,
  // Default exact hash mode in Settings > Search > Duplicates: "prepass" | "full".
  "duplicatePrecomputeExactMode": "prepass",

  // ---------------------------------------------------------------- Settings: Slideshow, Find RAW
  // Delay between photos in seconds: integer 1 to 60.
  "slideshowDelay": 5,
  // Loop.
  "slideshowLoop": true,
  // Random order.
  "slideshowRandom": false,
  // Find RAW: criteria that must all match (name without extension, date taken, camera and lens, shutter / ISO / aperture).
  "rawMatchName": false,
  "rawMatchDate": true,
  "rawMatchGear": true,
  "rawMatchShooting": true,
  // Find RAW: start folder: "parent" | "current" | "children".
  "rawScope": "parent",

  // ---------------------------------------------------------------- Face detection thresholds (frontend AND Rust)
  "faceSettings": {
    // Scan RAW files (embedded preview).
    "scanRaw": false,
    // Minimum face size in per mille of the photo's longest side: 0 to 500.
    "minSizePermille": 6,
    // Minimum detection confidence: 0.5 to 1.
    "minConfidence": 0.5,
    // Minimum sharpness: 0 to 2000.
    "minSharpness": 10,
    // Automatic attribution from this similarity: 0.2 to 1.
    "autoThreshold": 0.8,
    // Suggestion from this similarity: 0.2 to 1, below autoThreshold.
    "suggestionThreshold": 0.38,
    // Minimum gap with the next person: 0 to 0.5.
    "margin": 0.07
  },

  // ---------------------------------------------------------------- List panel
  // Columns shown in the List panel (filename is always shown first).
  "listVisibleColumns": ["filename", "extension", "date_taken", "rating", "color_flag"],
  // Display order of the columns in the List panel (filename is always pinned first).
  "listColumnOrder": ["filename", "extension", "file_size", "date_created", "date_modified", "resolution", "megapixels", "orientation", "ratio", "date_taken", "manufacturer", "camera", "lens", "author", "aperture", "shutter_speed", "iso", "focal_length", "flash", "rating", "color_flag", "pick_flag", "analysed", "faces_status", "geolocated", "phash", "exact_hash"],
  // Saved column widths in px (column id -> width).
  "listColumnWidths": {},
  // Active multi-column sort of the List panel: [{ col, dir }] (max 9 levels).
  "listSort": [],
  // Re-sort the thumbnail grid to match the List panel sort while the List panel is open (disabled on paged views > 50,000 photos).
  "listSyncGridSort": true,

  // ---------------------------------------------------------------- Settings: Import
  // Automatically detect connected removable photo media (OS device events, zero polling at rest).
  "importAutoDetect": true,
  // Automatically open the import view when an eligible photo media is connected.
  "importAutoOpen": false,
  // Comma-separated folder/file markers identifying a removable drive as a photo media.
  "importMediaMarkers": "DCIM, PRIVATE/M4ROOT, MP_ROOT, AVCHD",
  // Device filter mode: "blacklist" (all except blacklisted) | "whitelist" (only whitelisted).
  "importDeviceListMode": "blacklist",
  // Retain import history per media for 30 days only.
  "importHistoryRetention30d": false,
  // Last used import destination path inside the tracked library.
  "importLastDestination": "",
  // Last 5 import destinations.
  "importRecentDestinations": [],
  // Up to 10 favorite import destinations (stored alphabetically).
  "importFavoriteDestinations": [],
  // Import view file display mode: "list" | "thumbnails".
  "importViewMode": "list",
  // Import thumbnails layout: "square" | "framed".
  "importThumbnailLayout": "square",
  // Import thumbnails size in px: 100 to 320.
  "importThumbnailSize": 180,
  // Saved widths in px of the resizable import panels (null = CSS default).
  "importSidebarWidth": null,
  "importDestWidth": null,
  "importPreviewWidth": null,
  // Show preview pane in the import view.
  "importShowPreview": true,
  // Include subfolders when browsing a folder in the import source tree.
  "importIncludeSubfolders": true,
  // Hide folders without any media files in the import source tree.
  "importHideEmptyFolders": false,
  // Automatically select new (not yet imported) files when opening a source.
  "importAutoSelectNew": true,
  // Import list sort key: "date" | "name".
  "importSortKey": "date",
  // Import list sort order: "asc" | "desc".
  "importSortOrder": "desc",
  // Multi-column sort of the Import List view: [{ col, dir }] (max 9 levels).
  "importListSort": [],
  // Import list grouping: "none" | "day" | "month" | "folder".
  "importGroupBy": "none",
  // Collision policy at destination: "skip" | "rename" | "ask".
  "importCollisionPolicy": "skip",
  // Destination subfolder organization: "none" | "custom" | "yyyy_mm_dd" | "yyyy/yyyy_mm_dd" | "yyyy/mm" | "yyyy_mm_dd_custom".
  "importSubfolderMode": "none",
  // Custom subfolder name or suffix.
  "importCustomSubfolder": "",
  // Split imported files into subfolders by filetype (RAW / Raster / Video).
  "importSplitByType": false,
  "importSubfolderRaw": "RAW",
  "importSubfolderRaster": "JPEG",
  "importSubfolderVideo": "Video",
  // Optional post-import tasks (fixed order).
  "importPostRename": false,
  "importPostRenamePreset": "",
  "importPostIntegrity": false,
  "importPostFaces": false,
  "importPostHashes": false,
  "importPostSemantic": false
}
